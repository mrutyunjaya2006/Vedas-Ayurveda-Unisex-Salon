---
import businessConfig from '../data/business-config.json';
const currentYear = new Date().getFullYear();
---

<footer class="relative bg-[#2F2A26] text-[#F6F2EB] py-20 px-6 text-center overflow-hidden">
  <!-- Background Texture -->
  <img
    src="/assets/interior-main.png"
    alt=""
    class="absolute inset-0 w-full h-full object-cover opacity-15 blur-sm"
    aria-hidden="true"
  />
  <div class="absolute inset-0 bg-[#2F2A26]/90" aria-hidden="true"></div>

  <!-- Content Stack -->
  <div class="relative z-10 max-w-2xl mx-auto flex flex-col items-center">
    <!-- Logo Mark -->
    <img
      src="/assets/logo.png"
      alt=""
      class="h-16 w-auto mb-5 rounded-full"
      aria-hidden="true"
    />

    <!-- Brand Title -->
    <h2 class="font-serif text-3xl sm:text-4xl tracking-wide text-[#FFFDF9] mb-1">
      {businessConfig.shortName}
    </h2>
    <p class="text-xs uppercase tracking-[0.3em] text-[#D4C8BB] mb-6">
      Unisex Salon & Beauty Studio
    </p>

    <!-- Tagline -->
    <p class="text-sm sm:text-base text-[#EBE0D6] mb-8 font-light">
      Crafted for modern hair, beauty & effortless style in {businessConfig.city}.
    </p>

    <!-- Social / Action Icons -->
    <div class="flex items-center justify-center gap-4 mb-10">
      <!-- Instagram -->
      <a
        href={businessConfig.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-11 h-11 rounded-full bg-[#FFFDF9]/10 hover:bg-[#FFFDF9]/20 border border-[#D4C8BB]/25 flex items-center justify-center text-[#FFFDF9] transition-all"
        aria-label="Instagram"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
      </a>
      <!-- Phone -->
      <a
        href={businessConfig.phoneRaw}
        class="w-11 h-11 rounded-full bg-[#FFFDF9]/10 hover:bg-[#FFFDF9]/20 border border-[#D4C8BB]/25 flex items-center justify-center text-[#FFFDF9] transition-all"
        aria-label="Call us"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
      </a>
      <!-- WhatsApp -->
      <a
        href={businessConfig.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-11 h-11 rounded-full bg-[#FFFDF9]/10 hover:bg-[#FFFDF9]/20 border border-[#D4C8BB]/25 flex items-center justify-center text-[#FFFDF9] transition-all"
        aria-label="WhatsApp"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      </a>
      <!-- Google Maps -->
      <a
        href={businessConfig.googleMapsDirectUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-11 h-11 rounded-full bg-[#FFFDF9]/10 hover:bg-[#FFFDF9]/20 border border-[#D4C8BB]/25 flex items-center justify-center text-[#FFFDF9] transition-all"
        aria-label="Get directions"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
      </a>
    </div>

    <!-- Copyright -->
    <div class="text-xs text-[#D4C8BB]/60 border-t border-[#D4C8BB]/15 pt-6 w-full">
      <p class="mb-2">&copy; {currentYear} {businessConfig.name}. All rights reserved.</p>
      <div class="flex items-center justify-center gap-4">
        <a href="#home" class="hover:text-[#FFFDF9] transition-colors">Home</a>
        <span class="opacity-40">|</span>
        <a href="#services" class="hover:text-[#FFFDF9] transition-colors">Services</a>
        <span class="opacity-40">|</span>
        <a href="#contact" class="hover:text-[#FFFDF9] transition-colors">Contact</a>
      </div>
    </div>
  </div>
</footer>
