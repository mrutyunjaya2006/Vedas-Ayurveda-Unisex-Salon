---
import reviewsData from '../data/reviews.json';
import businessConfig from '../data/business-config.json';
const { summary, items } = reviewsData;
---

<section id="reviews" class="bg-[var(--bg-primary)] py-20 lg:py-28 px-6 border-t border-[#D4C8BB]">
  <div class="max-w-4xl mx-auto">
    <!-- Section Heading -->
    <h2 class="font-serif text-4xl lg:text-5xl text-[#4A3931] font-bold mb-10 text-center">
      Client Reviews
    </h2>

    <!-- Google Rating Summary Bar -->
    <div class="bg-[#FFFDF9] border border-[#D4C8BB] rounded-2xl px-6 sm:px-8 py-5 mb-10 flex flex-wrap items-center justify-between gap-4 shadow-sm">
      <div class="flex flex-wrap items-center gap-3">
        <span class="text-xl font-bold text-[#4A3931]">{summary.label}</span>
        <!-- 5 Stars -->
        <div class="flex gap-0.5">
          {[1,2,3,4,5].map(() => (
            <svg class="w-5 h-5" viewBox="0 0 20 20" fill="#E59819"><path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.44.91-5.32L2.27 6.62l5.34-.78z"/></svg>
          ))}
        </div>
        <span class="text-sm text-[#665B53]">
          <strong class="text-[#4A3931]">{summary.rating}</strong>
          {' '}
          <svg class="inline w-4 h-4 -mt-0.5" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
          {' '}Rating — Based on {summary.totalReviews} reviews
        </span>
      </div>
      <a
        href={businessConfig.googleMapsDirectUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#2F2A26] hover:bg-[#3C3732] text-[#FFFDF9] text-sm font-medium px-5 py-2.5 rounded-xl transition-colors"
      >
        Write a review
      </a>
    </div>

    <!-- Review Carousel -->
    <div class="relative" id="review-carousel">
      <!-- Navigation Buttons -->
      <button
        type="button"
        class="review-prev absolute top-1/2 -translate-y-1/2 -left-4 sm:-left-14 z-10 w-11 h-11 rounded-full bg-[#FFFDF9] border border-[#D4C8BB] text-[#4A3931] hover:bg-[#EBE0D6] flex items-center justify-center shadow-sm transition-colors"
        aria-label="Previous review"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </button>
      <button
        type="button"
        class="review-next absolute top-1/2 -translate-y-1/2 -right-4 sm:-right-14 z-10 w-11 h-11 rounded-full bg-[#FFFDF9] border border-[#D4C8BB] text-[#4A3931] hover:bg-[#EBE0D6] flex items-center justify-center shadow-sm transition-colors"
        aria-label="Next review"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>

      <!-- Review Cards Container -->
      <div class="overflow-hidden">
        <div class="review-track">
          {items.map((review: { id: number; name: string; initial: string; timeAgo: string; text: string; rating: number }, i: number) => (
            <div
              class:list={[
                'review-slide bg-[#FFFDF9] border border-[#D4C8BB] rounded-2xl p-8 sm:p-10 shadow-sm min-h-[240px] flex flex-col justify-between transition-opacity duration-300',
                i === 0 ? '' : 'hidden'
              ]}
              data-slide-index={i}
            >
              <!-- Top: Avatar + Name -->
              <div class="flex items-center gap-3 mb-5">
                <div class="w-11 h-11 rounded-full bg-[#4A3931] text-[#FFFDF9] font-semibold text-sm flex items-center justify-center shrink-0">
                  {review.initial}
                </div>
                <div>
                  <p class="font-semibold text-[#4A3931] text-sm">{review.name}</p>
                  <p class="text-xs text-[#665B53]">{review.timeAgo}</p>
                </div>
              </div>
              <!-- Review Text -->
              <p class="text-base sm:text-lg text-[#4A3931] leading-relaxed my-5 flex-1">
                "{review.text}"
              </p>
              <!-- Bottom: Stars + Google Icon -->
              <div class="flex items-center justify-between pt-4">
                <div class="flex gap-0.5">
                  {Array.from({ length: review.rating }).map(() => (
                    <svg class="w-4 h-4" viewBox="0 0 20 20" fill="#E59819"><path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.44.91-5.32L2.27 6.62l5.34-.78z"/></svg>
                  ))}
                </div>
                <svg class="w-6 h-6" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Pagination Dots -->
      <div class="flex justify-center items-center gap-2 mt-6" id="review-dots">
        {items.map((_: unknown, i: number) => (
          <button
            type="button"
            class:list={[
              'review-dot rounded-full transition-all duration-300',
              i === 0 ? 'w-6 h-2 bg-[#4A3931]' : 'w-2 h-2 bg-[#D4C8BB]'
            ]}
            data-dot-index={i}
            aria-label={`Go to review ${i + 1}`}
          ></button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  function initReviewCarousel() {
    const slides = document.querySelectorAll('.review-slide');
    const dots = document.querySelectorAll('.review-dot');
    const prevBtn = document.querySelector('.review-prev');
    const nextBtn = document.querySelector('.review-next');
    const carousel = document.getElementById('review-carousel');
    if (!slides.length || !dots.length) return;

    let current = 0;
    let autoTimer: ReturnType<typeof setInterval>;

    function showSlide(index: number) {
      slides.forEach((s, i) => {
        if (i === index) {
          s.classList.remove('hidden');
        } else {
          s.classList.add('hidden');
        }
      });
      dots.forEach((d, i) => {
        if (i === index) {
          d.classList.remove('w-2', 'h-2', 'bg-[#D4C8BB]');
          d.classList.add('w-6', 'h-2', 'bg-[#4A3931]');
        } else {
          d.classList.remove('w-6', 'bg-[#4A3931]');
          d.classList.add('w-2', 'h-2', 'bg-[#D4C8BB]');
        }
      });
      current = index;
    }

    function next() { showSlide((current + 1) % slides.length); }
    function prev() { showSlide((current - 1 + slides.length) % slides.length); }

    function startAuto() { autoTimer = setInterval(next, 4500); }
    function stopAuto() { clearInterval(autoTimer); }

    nextBtn?.addEventListener('click', () => { stopAuto(); next(); startAuto(); });
    prevBtn?.addEventListener('click', () => { stopAuto(); prev(); startAuto(); });
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => { stopAuto(); showSlide(i); startAuto(); });
    });

    carousel?.addEventListener('mouseenter', stopAuto);
    carousel?.addEventListener('mouseleave', startAuto);

    startAuto();
  }

  document.addEventListener('DOMContentLoaded', initReviewCarousel);
  document.addEventListener('astro:page-load', initReviewCarousel);
</script>
