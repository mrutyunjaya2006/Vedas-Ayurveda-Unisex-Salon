---
import businessConfig from '../data/business-config.json';
---

<section id="about" class="bg-[var(--bg-primary)] py-20 lg:py-28 px-6">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

    <!-- Left Column: Image Collage (7 cols) -->
    <div class="lg:col-span-7 relative">
      <img
        src="/assets/interior.jpg"
        alt="Vedas Salon interior with modern styling stations"
        class="w-full rounded-2xl border border-[#D4C8BB] shadow-sm aspect-[4/3] object-cover"
        loading="lazy"
      />
      <!-- Overlapping Badge -->
      <div class="absolute -bottom-4 -right-2 sm:bottom-6 sm:right-6 bg-[#FFFDF9] border border-[#D4C8BB] rounded-xl px-5 py-4 shadow-md max-w-[240px]">
        <p class="font-serif text-2xl font-bold text-[#4A3931] mb-1">11+ Years</p>
        <p class="text-xs text-[#665B53] leading-snug">
          in Chandrasekharpur. Top global brands used.
        </p>
      </div>
    </div>

    <!-- Right Column: Editorial Story (5 cols) -->
    <div class="lg:col-span-5">
      <p class="text-xs uppercase tracking-[0.2em] text-[#665B53] mb-3">About Vedas Salon</p>

      <h2 class="font-serif text-3xl lg:text-4xl text-[#4A3931] mb-6 font-bold leading-tight">
        Modern Craftsmanship Meets Everyday Luxury.
      </h2>

      <div class="space-y-4 text-[15px] text-[#665B53] leading-relaxed mb-8">
        <p>
          For over 11 years near Trident College and Infocity Road, Vedas Ayurveda Unisex Salon
          has been the go-to destination for students, working professionals, and brides across
          Chandrasekharpur and Patia.
        </p>
        <p>
          We operate as a full-scale modern unisex styling studio. Our senior certified stylists
          work with industry-leading international products for hair colouring, keratin smoothing,
          skin care treatments, and bridal makeovers — delivering five-star ambience at
          genuinely pocket-friendly prices.
        </p>
      </div>

      <!-- 3 Pillars -->
      <div class="space-y-3">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-[#4A6B2C] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          <span class="text-sm font-medium text-[#4A3931]">Senior Certified Stylists</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-[#4A6B2C] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          <span class="text-sm font-medium text-[#4A3931]">100% Authentic Global Products</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-[#4A6B2C] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          <span class="text-sm font-medium text-[#4A3931]">Hygienic & Relaxing Ambience</span>
        </div>
      </div>
    </div>
  </div>
</section>
