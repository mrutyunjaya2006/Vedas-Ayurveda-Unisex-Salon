---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
import businessConfig from '../data/business-config.json';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${businessConfig.name} | Premier Unisex Salon in ${businessConfig.city}`,
  description = 'Professional unisex salon in Chandrasekharpur, Bhubaneswar offering precision haircuts, global colour, keratin treatments, skin rituals, bridal artistry, and grooming services.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_IN" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[var(--bg-primary)] text-[var(--text-body)] font-sans antialiased min-h-screen flex flex-col selection:bg-[var(--btn-primary)] selection:text-white">
    <Header />
    <main class="flex-grow" id="home">
      <slot />
    </main>
    <Footer />
    <FloatingActions />
  </body>
</html>
